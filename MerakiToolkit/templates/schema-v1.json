{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MerakiToolkit Configuration Template v1",
  "$defs": {
    "ssid": {
      "type": "object",
      "required": [
        "number",
        "settings"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "vlan": {
      "type": "object",
      "required": [
        "id",
        "settings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {
              "type": "string"
            },
            "subnet": {
              "type": "string"
            },
            "applianceIp": {
              "type": "string"
            }
          }
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "serial",
        "portId",
        "settings"
      ],
      "additionalProperties": false,
      "properties": {
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "portId": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "access",
                "trunk"
              ]
            },
            "vlan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4094
            },
            "allowedVlans": {
              "type": "string"
            }
          }
        }
      }
    },
    "firewallRule": {
      "type": "object",
      "required": [
        "policy",
        "protocol",
        "srcCidr",
        "destCidr"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "protocol": {
          "enum": [
            "any",
            "icmp",
            "icmp6",
            "tcp",
            "udp"
          ]
        },
        "srcCidr": {
          "type": "string"
        },
        "destCidr": {
          "type": "string"
        },
        "srcPort": {
          "type": "string"
        },
        "destPort": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "syslogEnabled": {
          "type": "boolean"
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "kind",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "MerakiConfigLayer"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "description": {
          "type": "string"
        },
        "wirelessSsids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ssid"
          }
        },
        "applianceVlans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vlan"
          }
        },
        "switchPorts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "applianceL3FirewallRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rules"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/firewallRule"
              }
            }
          }
        }
      }
    },
    "assignment": {
      "type": "object",
      "required": [
        "kind",
        "schemaVersion",
        "networkId",
        "base"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "MerakiConfigAssignment"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "description": {
          "type": "string"
        },
        "networkId": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/assignment"
    },
    {
      "$ref": "#/$defs/layer"
    }
  ]
}
